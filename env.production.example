# ---------------------------------------------------------------------------
# B9 Game — production environment
#
# Copy this file to `.env.local` next to this file and fill every value.
# Never commit the filled file.
#
# Important: the server loads `.env.local` (not `.env`) from the vue-app folder.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=3001

# --- Authentication --------------------------------------------------------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The administrator account is created / synchronised at every server start
# from these two values. Changing the password here and restarting resets it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional comma-separated allowlist of client IPs permitted to use /api/admin.
# Leave empty to allow any IP that presents a valid admin token.
# Forwarded headers are ignored; the value must be the address this server sees.
ADMIN_ALLOWED_IPS=

# --- Database --------------------------------------------------------------
# Optional absolute path for the SQLite file.
# Default: <vue-app>/server/database.sqlite
# Keep this outside the public document root.
SQLITE_PATH=

# Local backup snapshots and retention
DB_BACKUP_INTERVAL_MS=86400000
DB_BACKUP_RETENTION=14

# --- Google Sign-In --------------------------------------------------------
# Public client ID. It is sent to the browser and used to verify ID tokens.
GOOGLE_CLIENT_ID=

# --- Game provider (HUIDU) -------------------------------------------------
# Server-side only. Never expose these to the browser or put them in a VITE_ var.
HUIDU_SERVER_URL=https://jsgame.live
HUIDU_AGENCY_UID=
HUIDU_AES_KEY=
HUIDU_PLAYER_PREFIX=
GAME_CURRENCY_IN=INR
GAME_CURRENCY_PK=PKR
GAME_CURRENCY_NP=NPR

# --- Manual deposit / withdrawal instructions (shown to players) -----------
MANUAL_PAYMENT_BANK_NAME=
MANUAL_PAYMENT_ACCOUNT_NAME=
MANUAL_PAYMENT_ACCOUNT_NUMBER=
MANUAL_PAYMENT_IBAN=
MANUAL_PAYMENT_UPI_ID=
MANUAL_PAYMENT_WALLET_NAME=
MANUAL_PAYMENT_WALLET_NUMBER=
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the exact amount, then submit your transaction reference and payment receipt.

# --- Email OTP (optional) --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS OTP (optional) ----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Monitoring (optional) -------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# BUILD-TIME ONLY (not read by the running server)
#
# VITE_ADMIN_PANEL_PATH sets the browser route of the admin panel. It is baked
# into the frontend at build time. The bundled dist/ was built with:
#     VITE_ADMIN_PANEL_PATH=/control-your-private-admin-path
# which means the admin page is reachable at https://your-domain/control-your-private-admin-path
#
# To use a different path, rebuild the frontend on the server:
#     VITE_ADMIN_PANEL_PATH=/your-secret-path npm run build
# This value is a convenience, NOT a security control — real protection comes
# from the admin JWT, the password and ADMIN_ALLOWED_IPS.
# ---------------------------------------------------------------------------
